{
  "name": "k8s-cheatsheet-app",
  "private": true,
  "version": "1.4.3-dev",
  "description": "Kubernetes Cheatsheet Application",
  "author": "Monesh Ram",
  "repository": {
    "type": "git",
    "url": "https://github.com/WhoisMonesh/k8s-cheatsheet-app"
  },
  "homepage": "./",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:5173 && tsc -p electron/tsconfig.json && node electron/generate-package-json.cjs && electron .\"",
    "electron:build": "tsc -p electron/tsconfig.json && node electron/generate-package-json.cjs && vite build && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.k8s.cheatsheet",
    "productName": "K8s Cheatsheet",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "WhoisMonesh",
        "repo": "k8s-cheatsheet-app"
      }
    ]
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "jimp": "^1.6.1",
    "lucide-react": "^0.577.0",
    "png-to-ico": "^3.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.10.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.13",
    "wait-on": "^9.0.10"
  }
}
